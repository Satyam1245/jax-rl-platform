# Pytest local temp directory (redirected from system temp to avoid Windows PermissionError)
.tmp/

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging and coverage output
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Local IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local experiment artifacts; keep the directories in the project tree.
experiments/*
!experiments/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
results/*
!results/.gitkeep
